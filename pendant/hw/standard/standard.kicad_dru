(version 1)
# JLCPCB 2-layer 1 oz limits that the board-wide minimums in standard.kicad_pro cannot express (DESIGN.md §7).
# Source: https://jlcpcb.com/capabilities/pcb-capabilities (read 2026-10-18).

(rule "SMD pad to pad 0.15 (JLCPCB)"
  (constraint clearance (min 0.15mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "PTH hole to track 0.28 (JLCPCB)"
  (constraint hole_clearance (min 0.28mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "PTH pad hole to hole 0.45 (JLCPCB)"
  (constraint hole_to_hole (min 0.45mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'"))
